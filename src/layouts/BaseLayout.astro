---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Sidebar from "../components/Sidebar.astro";
import type { TocItem } from "../data/article";
import { getSiteConfig } from "../data/backend";
import { withBase } from "../utils/url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  toc?: TocItem[];
  article?: boolean;
}

const config = await getSiteConfig();
const {
  title = config.title,
  description = config.description,
  toc,
  article,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {config.icons.faviconSvg ? (
      <link rel="icon" type="image/svg+xml" href={config.icons.faviconSvg} />
    ) : null}
    {config.icons.favicon96 ? (
      <link
        rel="icon"
        type="image/png"
        sizes="96x96"
        href={config.icons.favicon96}
      />
    ) : null}
    {config.icons.appleTouchIcon ? (
      <link
        rel="apple-touch-icon"
        sizes="180x180"
        href={config.icons.appleTouchIcon}
      />
    ) : null}
    {config.icons.webApp192 ? (
      <link
        rel="icon"
        type="image/png"
        sizes="192x192"
        href={config.icons.webApp192}
      />
    ) : null}
    {config.icons.webApp512 ? (
      <link
        rel="icon"
        type="image/png"
        sizes="512x512"
        href={config.icons.webApp512}
      />
    ) : null}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@5.15.4/css/all.min.css"
    />
    <title>{title}</title>
  </head>
  <body id="top">
    <canvas id="evanyou" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="site-shell">
      <SiteHeader />
      <div class="site-body">
        <main id="main" class="site-main">
          <slot />
        </main>
        <Sidebar toc={toc} article={article} />
      </div>
      <SiteFooter />
    </div>

    <a class="back-to-top" href="#top" aria-label="回到顶部">
      <img src={withBase("/images/scroll.png")} alt="" />
    </a>

    <script>
      import mediumZoom from "medium-zoom";

      const imageSelector =
        ".post-body-single img, .post-single-cover, .post-cover img";

      for (const image of document.querySelectorAll<HTMLImageElement>(
        imageSelector,
      )) {
        image.draggable = false;
        image.addEventListener("dragstart", (event) => event.preventDefault());
        image.addEventListener("click", (event) => {
          if (image.closest("a")) {
            event.preventDefault();
          }
        });
      }

      mediumZoom(imageSelector, {
        margin: 24,
        background: "#fff",
      });
    </script>

    <script is:inline>
      (() => {
        const button = document.querySelector(".back-to-top");
        if (!button) return;

        const update = () => {
          button.style.top =
            window.scrollY > 700
              ? `${window.innerHeight - 980}px`
              : "-900px";
        };

        update();
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
      })();
    </script>

    <script is:inline>
      if (document.getElementById("evanyou")) {
        const canvas = document.getElementById("evanyou");
        const context = canvas.getContext("2d");
        const ratio = window.devicePixelRatio || 1;
        const width = window.innerWidth;
        const height = window.innerHeight;
        const f = 90;
        const tau = Math.PI * 2;
        let r = 0;
        let queue;

        canvas.width = width * ratio;
        canvas.height = height * ratio;
        context.scale(ratio, ratio);
        context.globalAlpha = 0.6;

        function evanyou() {
          context.clearRect(0, 0, width, height);
          queue = [
            { x: 0, y: height * 0.7 + f },
            { x: 0, y: height * 0.7 - f },
          ];
          while (queue[1].x < width + f) draw(queue[0], queue[1]);
        }

        function draw(i, j) {
          context.beginPath();
          context.moveTo(i.x, i.y);
          context.lineTo(j.x, j.y);
          const k = j.x + (Math.random() * 2 - 0.25) * f;
          const n = nextY(j.y);
          context.lineTo(k, n);
          context.closePath();
          r -= tau / -50;
          const red = Math.cos(r) * 127 + 128;
          const green = Math.cos(r + tau / 3) * 127 + 128;
          const blue = Math.cos(r + (tau * 2) / 3) * 127 + 128;
          const color = ((red << 16) | (green << 8) | blue) >>> 0;
          context.fillStyle = `#${color.toString(16).padStart(6, "0")}`;
          context.fill();
          queue[0] = queue[1];
          queue[1] = { x: k, y: n };
        }

        function nextY(p) {
          const t = p + (Math.random() * 2 - 1.1) * f;
          return t > height || t < 0 ? nextY(p) : t;
        }

        document.onclick = evanyou;
        document.ontouchstart = evanyou;
        evanyou();
      }
    </script>
  </body>
</html>
