---
interface Props {
  name: string;
}

const { name } = Astro.props;

const icons: Record<string, string> = {
  home: "fas fa-meteor",
  archive: "fas fa-archive",
  heart: "fas fa-mars-stroke",
  user: "fas fa-heartbeat",
  flask: "fas fa-magic",
  message: "fas fa-comment-dots",
};

const className = icons[name] ?? "fas fa-link";
---

<i class={`menu-icon ${className}`} aria-hidden="true" />
