---
import { footerConfig } from "../blog.config";
import { getSiteConfig } from "../data/backend";

const config = await getSiteConfig();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-image" aria-hidden="true">
    <img src="/images/footer.png" alt="" />
  </div>

  <div class="footer-inner">
    {footerConfig.since ? (
      <p class="footer-runtime">
        博客已萌萌哒运行
        <span class="footer-since" data-since={footerConfig.since}></span>
        <span class="my-face">(●'◡'●)ﾉ♥</span>
      </p>
    ) : null}

    <p>
      © {year} {config.author}. 由{" "}
      <a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>{" "}
      强力驱动. Theme By{" "}
      <a
        href="https://github.com/DIYgod/hexo-theme-sagiri"
        target="_blank"
        rel="noreferrer"
      >
        Sagiri
      </a>
      .
      {footerConfig.icp ? (
        <span class="footer-icp">
          {" "}
          {footerConfig.icpUrl ? (
            <a href={footerConfig.icpUrl} target="_blank" rel="noreferrer">
              {footerConfig.icp}
            </a>
          ) : (
            footerConfig.icp
          )}
        </span>
      ) : null}
    </p>

    <p class="footer-made">
      Made with <span class="footer-heart" aria-hidden="true">♥</span> by{" "}
      {footerConfig.madeByUrl ? (
        <a href={footerConfig.madeByUrl} target="_blank" rel="noreferrer">
          {footerConfig.madeBy || config.author}
        </a>
      ) : (
        footerConfig.madeBy || config.author
      )}
      .
    </p>
  </div>
</footer>

<script is:inline>
  (() => {
    const element = document.querySelector("[data-since]");
    if (!element) return;

    const since = Date.parse(element.dataset.since);
    if (!Number.isFinite(since)) return;

    const tick = () => {
      const diff = Math.max(0, Date.now() - since);
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const minutes = Math.floor((diff % 3600000) / 60000);
      const seconds = Math.floor((diff % 60000) / 1000);
      element.textContent = `${days}天${hours}小时${minutes}分${seconds}秒`;
    };

    tick();
    window.setInterval(tick, 1000);
  })();
</script>
