---
import SocialIcon from "./SocialIcon.astro";
import {
  getSiteConfig,
  resolveSocialHref,
  resolveSocialIcon,
  socialLabel,
} from "../data/backend";
import { posts } from "../data/posts";

const config = await getSiteConfig();
const socialLinks = config.social;

const stats = [
  { label: "文章", value: String(posts.length) },
  {
    label: "标签",
    value: String(new Set(posts.flatMap((post) => post.tags)).size),
  },
  {
    label: "分类",
    value: String(new Set(posts.map((post) => post.category)).size),
  },
];
---

<aside class="site-sidebar">
  <section class="sidebar-card author-card">
    <div class="author-profile">
      <div
        class="author-cover"
        style={`background-image: url('${config.avatar}')`}
      >
      </div>
      <h2 class="author-name">{config.author}</h2>
      <p class="author-description site-description motion-element">{config.tagline}</p>
    </div>

    <div class="author-social">
      {socialLinks.map((link) => (
        <a
          href={resolveSocialHref(link)}
          target={link.platform === "email" ? undefined : "_blank"}
          rel={link.platform === "email" ? undefined : "me noreferrer"}
          aria-label={socialLabel(link)}
        >
          <SocialIcon
            platform={link.platform}
            icon={resolveSocialIcon(link)}
            label={socialLabel(link)}
          />
          <span>{socialLabel(link)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">站点统计</h3>
    <dl class="site-stats">
      {stats.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">最新文章</h3>
    <ol class="sidebar-posts">
      {posts.slice(0, 5).map((post) => (
        <li>
          <a href={`/post/${post.slug}/`}>{post.title}</a>
        </li>
      ))}
    </ol>
  </section>
</aside>
