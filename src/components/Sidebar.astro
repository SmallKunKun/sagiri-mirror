---
import { site } from "../data/site";
---

<aside class="site-sidebar">
  <section class="sidebar-card author-card">
    <div class="author-avatar" aria-hidden="true">{site.author.slice(0, 1)}</div>
    <h2 class="author-name">{site.author}</h2>
    <p class="author-description">{site.description}</p>

    <div class="author-social">
      {site.social.map((item) => (
        <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
      ))}
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">站点统计</h3>
    <dl class="site-stats">
      {site.stats.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">目录</h3>
    <p class="sidebar-muted">文章页会在这里显示目录。</p>
  </section>
</aside>
