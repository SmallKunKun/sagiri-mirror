---
import SocialIcon from "./SocialIcon.astro";
import type { TocItem } from "../data/article";
import {
  getSiteConfig,
  resolveSocialHref,
  resolveSocialIcon,
  socialLabel,
} from "../data/backend";
import { getPosts } from "../data/posts";

interface Props {
  toc?: TocItem[];
}

const { toc = [] } = Astro.props;
const config = await getSiteConfig();
const socialLinks = config.social;
const allPosts = await getPosts();

const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
  if (post.category === "未分类") continue;
  categoryCounts.set(
    post.category,
    (categoryCounts.get(post.category) ?? 0) + 1,
  );
}
const categories = [...categoryCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<aside class="site-sidebar">
  {toc.length > 1 ? (
    <section class="sidebar-card">
      <h3 class="sidebar-title">目录</h3>
      <ul class="post-toc">
        {toc.map((item) => (
          <li class={`post-toc-level-${item.level}`}>
            <a href={`#${item.id}`}>{item.text}</a>
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  <section class="sidebar-card author-card">
    <div class="author-profile">
      <div
        class="author-cover"
        style={`background-image: url('${config.avatar}')`}
      >
      </div>
      <h2 class="author-name">{config.author}</h2>
      <p class="author-description site-description motion-element">{config.tagline}</p>
    </div>

    <div class="author-social">
      {socialLinks.map((link) => (
        <a
          href={resolveSocialHref(link)}
          target={link.platform === "email" ? undefined : "_blank"}
          rel={link.platform === "email" ? undefined : "me noreferrer"}
          aria-label={socialLabel(link)}
        >
          <SocialIcon
            platform={link.platform}
            icon={resolveSocialIcon(link)}
            label={socialLabel(link)}
          />
          <span>{socialLabel(link)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">分类</h3>
    {categories.length > 0 ? (
      <ul class="sidebar-terms">
        {categories.map(([name, count]) => (
          <li>
            <a href={`/categories/${encodeURIComponent(name)}/`}>
              <span>{name}</span>
              <span class="sidebar-count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="sidebar-muted">暂无分类</p>
    )}
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">标签</h3>
    {tags.length > 0 ? (
      <ul class="sidebar-tags">
        {tags.map(([name, count]) => (
          <li>
            <a href={`/tags/${encodeURIComponent(name)}/`}>
              #{name}
              <span class="sidebar-count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="sidebar-muted">暂无标签</p>
    )}
  </section>
</aside>
