---
import { site } from "../data/site";
import { posts } from "../data/posts";

const stats = [
  { label: "文章", value: String(posts.length) },
  {
    label: "标签",
    value: String(new Set(posts.flatMap((post) => post.tags)).size),
  },
  {
    label: "分类",
    value: String(new Set(posts.map((post) => post.category)).size),
  },
];
---

<aside class="site-sidebar">
  <section class="sidebar-card author-card">
    <div
      class="author-cover"
      style={`background-image: url('${site.card}')`}
      aria-hidden="true"
    >
    </div>
    <h2 class="author-name">{site.author}</h2>
    <p class="author-description">{site.tagline}</p>

    <div class="author-social">
      {site.social.map((item) => (
        <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
      ))}
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">站点统计</h3>
    <dl class="site-stats">
      {stats.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sidebar-card">
    <h3 class="sidebar-title">最新文章</h3>
    <ol class="sidebar-posts">
      {posts.slice(0, 5).map((post) => (
        <li>
          <a href={`/post/${post.slug}/`}>{post.title}</a>
        </li>
      ))}
    </ol>
  </section>
</aside>
