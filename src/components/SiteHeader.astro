---
import BrandTitle from "./BrandTitle.astro";
import NavIcon from "./NavIcon.astro";
import { getSiteConfig } from "../data/backend";

const config = await getSiteConfig();
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<header class="site-header">
  <div class="site-nav-bar">
    <nav class="site-nav" aria-label="主导航">
      <ul class="site-menu">
        {config.navLinks.map((item) => (
          <li class:list={["menu-item", { "has-children": item.children?.length }]}>
            {item.children?.length ? (
              <button class="menu-parent" type="button" aria-haspopup="true">
                {item.icon ? <NavIcon name={item.icon} /> : null}
                {item.label}
              </button>
            ) : (
              <a
                href={item.href}
                target={isExternal(item.href) ? "_blank" : undefined}
                rel={isExternal(item.href) ? "noreferrer" : undefined}
              >
                {item.icon ? <NavIcon name={item.icon} /> : null}
                {item.label}
              </a>
            )}

            {item.children?.length ? (
              <ul class="submenu">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      target={isExternal(child.href) ? "_blank" : undefined}
                      rel={isExternal(child.href) ? "noreferrer" : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}

        <li class="menu-item menu-search">
          <form class="search-form" action="/search/" method="get" role="search">
            <label class="sr-only" for="site-search">站内搜索</label>
            <input
              id="site-search"
              class="search-input"
              type="search"
              name="q"
              placeholder="站内搜索"
            />
            <button class="search-submit" type="submit" aria-label="搜索">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m16.5 16.5 4 4"></path>
              </svg>
            </button>
          </form>
        </li>
      </ul>
    </nav>
  </div>

  <div
    class="site-banner"
    style={`--banner-image: url('${config.bannerImage}')`}
  >
    <div class="site-banner-inner">
      <BrandTitle text={config.title} />
    </div>
  </div>

  <div class="site-master">
    <img class="site-master-avatar" src={config.avatar} alt="" />
    <h2 class="site-master-description">{config.tagline}</h2>
  </div>
</header>
