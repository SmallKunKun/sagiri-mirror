---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="site-nav-bar">
    <nav class="site-nav" aria-label="主导航">
      <ul class="site-menu">
        {site.nav.map((item) => (
          <li class:list={["menu-item", { "has-children": item.children?.length }]}>
            {item.children?.length ? (
              <button class="menu-parent" type="button" aria-haspopup="true">
                {item.label}
              </button>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}

            {item.children?.length ? (
              <ul class="submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} target="_blank" rel="noreferrer">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="site-banner">
    <div class="site-banner-inner">
      <h1 class="site-banner-title">{site.title}</h1>
      <p class="site-banner-subtitle">{site.subtitle}</p>
    </div>
  </div>

  <div class="site-master">
    <div class="site-master-avatar" aria-hidden="true">
      {site.author.slice(0, 1)}
    </div>
    <p class="site-master-description">{site.description}</p>
  </div>
</header>
