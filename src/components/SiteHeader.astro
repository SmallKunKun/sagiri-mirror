---
import BrandTitle from "./BrandTitle.astro";
import NavIcon from "./NavIcon.astro";
import { getSiteConfig } from "../data/backend";
import { withBase } from "../utils/url";

const config = await getSiteConfig();
const isExternal = (href: string) => /^https?:\/\//.test(href);
const hrefOf = (href: string) => (isExternal(href) ? href : withBase(href));
---

<header class="site-header">
  <div class="site-nav-bar">
    <nav class="site-nav" aria-label="主导航">
      <ul class="site-menu">
        {config.navLinks.map((item) => (
          <li class:list={["menu-item", { "has-children": item.children?.length }]}>
            {item.children?.length ? (
              <button class="menu-parent" type="button" aria-haspopup="true">
                {item.icon ? <NavIcon name={item.icon} /> : null}
                {item.label}
              </button>
            ) : (
              <a
                href={hrefOf(item.href)}
                target={isExternal(item.href) ? "_blank" : undefined}
                rel={isExternal(item.href) ? "noreferrer" : undefined}
              >
                {item.icon ? <NavIcon name={item.icon} /> : null}
                {item.label}
              </a>
            )}

            {item.children?.length ? (
              <ul class="submenu">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={hrefOf(child.href)}
                      target={isExternal(child.href) ? "_blank" : undefined}
                      rel={isExternal(child.href) ? "noreferrer" : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}

        <li class="menu-item menu-search">
          <form
            class="search-form"
            action={withBase("/search/")}
            method="get"
            role="search"
          >
            <label class="sr-only" for="site-search">站内搜索</label>
            <input
              id="site-search"
              class="search-input"
              type="search"
              name="q"
              placeholder="站内搜索"
            />
            <button class="search-submit" type="submit" aria-label="搜索">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m16.5 16.5 4 4"></path>
              </svg>
            </button>
          </form>

          <div class="theme-switcher">
            <button
              class="theme-toggle"
              type="button"
              aria-label="切换主题"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="theme-menu"
            >
              <i
                class="fas fa-adjust theme-icon theme-icon-auto"
                aria-hidden="true"
              ></i>
              <i
                class="fas fa-sun theme-icon theme-icon-light"
                aria-hidden="true"
              ></i>
              <i
                class="fas fa-moon theme-icon theme-icon-dark"
                aria-hidden="true"
              ></i>
            </button>

            <div class="theme-menu" id="theme-menu" role="menu" hidden>
              <button
                type="button"
                role="menuitemradio"
                data-theme-choice="auto"
                aria-checked="true"
              >
                自动
              </button>
              <button
                type="button"
                role="menuitemradio"
                data-theme-choice="light"
                aria-checked="false"
              >
                白天
              </button>
              <button
                type="button"
                role="menuitemradio"
                data-theme-choice="dark"
                aria-checked="false"
              >
                黑夜
              </button>
            </div>
          </div>
        </li>
      </ul>
    </nav>
  </div>

  <div
    class="site-banner"
    style={
      config.bannerImage
        ? `--banner-image: url('${config.bannerImage}')`
        : undefined
    }
  >
    <div class="site-banner-inner">
      <BrandTitle text={config.title} />
    </div>
  </div>

  <div class="site-master">
    <img class="site-master-avatar" src={config.avatar} alt="" />
    <h2 class="site-master-description">{config.tagline}</h2>
  </div>
</header>

<script is:inline>
  (() => {
    const key = "sagiri-theme";
    const root = document.documentElement;
    const toggle = document.querySelector(".theme-toggle");
    const menu = document.getElementById("theme-menu");
    const choices = [...document.querySelectorAll("[data-theme-choice]")];
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    if (!toggle || !menu) return;

    const apply = (mode, persist = true) => {
      const next =
        mode === "light" || mode === "dark" || mode === "auto" ? mode : "auto";
      const dark = next === "dark" || (next === "auto" && media.matches);

      root.dataset.themeMode = next;
      root.dataset.theme = dark ? "dark" : "light";

      if (persist) {
        try {
          localStorage.setItem(key, next);
        } catch {
          // Storage can be unavailable in private mode.
        }
      }

      for (const choice of choices) {
        choice.setAttribute(
          "aria-checked",
          String(choice.dataset.themeChoice === next),
        );
      }
    };

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    };

    const open = () => {
      menu.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      menu.hidden ? open() : close();
    });

    for (const choice of choices) {
      choice.addEventListener("click", () => {
        apply(choice.dataset.themeChoice);
        close();
        toggle.focus();
      });
    }

    document.addEventListener("click", (event) => {
      const switcher = toggle.closest(".theme-switcher");
      if (!menu.hidden && switcher && !switcher.contains(event.target)) {
        close();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        close();
        toggle.focus();
      }
    });

    const onChange = () => {
      if ((root.dataset.themeMode || "auto") === "auto") {
        apply("auto", false);
      }
    };

    if (media.addEventListener) {
      media.addEventListener("change", onChange);
    } else {
      media.addListener(onChange);
    }

    apply(root.dataset.themeMode || "auto", false);
  })();
</script>
