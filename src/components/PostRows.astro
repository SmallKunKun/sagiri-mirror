---
import type { PostSummary } from "../data/posts";

interface Props {
  posts: PostSummary[];
}

const { posts } = Astro.props;

const plateCharacter = (title: string) => {
  const characters = Array.from(title.trim());
  return (
    characters.find((character) => /[\p{L}\p{N}]/u.test(character)) ??
    characters[0] ??
    ""
  );
};
---

<ul class="post-rows">
  {posts.map((post) => (
    <li>
      <a class="post-row" href={`/post/${post.slug}/`}>
        {post.cover ? (
          <img
            class="post-row-cover"
            src={post.cover.url}
            alt=""
            loading="lazy"
          />
        ) : (
          <span class="post-row-cover post-row-plate" aria-hidden="true">
            {plateCharacter(post.title)}
          </span>
        )}

        <span class="post-row-main">
          <span class="post-row-title">{post.title}</span>
          {post.summary ? (
            <span class="post-row-summary">{post.summary}</span>
          ) : null}
          <span class="post-row-meta">
            <time datetime={post.publishedAt}>
              {post.publishedAt.slice(0, 10)}
            </time>
            {post.category !== "未分类" ? <span>{post.category}</span> : null}
            <span>{post.readingTime} 分钟</span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
