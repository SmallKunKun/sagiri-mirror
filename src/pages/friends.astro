---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOG_ORIGIN, getSiteConfig } from "../data/backend";

interface FriendLink {
  siteName: string;
  siteUrl: string;
  description?: string;
  logoUrl?: string;
}

const config = await getSiteConfig();
const friends = await loadFriends();

const plateCharacter = (name: string) => {
  const characters = Array.from(name.trim());
  return (
    characters.find((character) => /[\p{L}\p{N}]/u.test(character)) ??
    characters[0] ??
    ""
  );
};

async function loadFriends(): Promise<FriendLink[]> {
  try {
    const response = await fetch(`${BLOG_ORIGIN}/api/friend-links`, {
      signal: AbortSignal.timeout(5000),
    });
    if (!response.ok) throw new Error(`${response.status}`);

    const value = (await response.json()) as unknown;
    if (!Array.isArray(value)) return [];

    return value.filter(
      (item): item is FriendLink =>
        typeof item === "object" &&
        item !== null &&
        typeof (item as Record<string, unknown>).siteName === "string" &&
        typeof (item as Record<string, unknown>).siteUrl === "string",
    );
  } catch (error) {
    console.warn(
      `[friends] Could not read ${BLOG_ORIGIN}/api/friend-links.`,
      error,
    );
    return [];
  }
}
---

<BaseLayout title={`友链 | ${config.title}`}>
  <section class="friends-page">
    <h2 class="friends-title">友链</h2>

    {friends.length === 0 ? (
      <p class="friends-empty">暂无友链</p>
    ) : (
      <ul class="friends-list">
        {friends.map((friend) => (
          <li>
            <a
              href={friend.siteUrl}
              title={friend.siteName}
              target="_blank"
              rel="noreferrer"
            >
              {friend.logoUrl ? (
                <img src={friend.logoUrl} alt="" loading="lazy" />
              ) : (
                <span class="friend-logo-placeholder" aria-hidden="true">
                  {plateCharacter(friend.siteName)}
                </span>
              )}
              <h4>{friend.siteName}</h4>
              {friend.description ? <p>{friend.description}</p> : null}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
