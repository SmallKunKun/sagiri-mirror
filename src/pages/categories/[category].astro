---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { getSiteConfig } from "../../data/backend";
import { getPosts, type PostSummary } from "../../data/posts";

interface Props {
  category: string;
  posts: PostSummary[];
}

export async function getStaticPaths() {
  const allPosts = await getPosts();
  const categories = [
    ...new Set(
      allPosts
        .map((post) => post.category)
        .filter((category) => category !== "未分类"),
    ),
  ];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: allPosts.filter((post) => post.category === category),
    },
  }));
}

const { category, posts } = Astro.props as Props;
const config = await getSiteConfig();
---

<BaseLayout title={`分类：${category} | ${config.title}`}>
  <h2 class="archive-title">分类：{category}</h2>
  <PostList posts={posts} />
</BaseLayout>
