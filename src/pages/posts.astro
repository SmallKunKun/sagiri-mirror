---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRows from "../components/PostRows.astro";
import { getSiteConfig } from "../data/backend";
import { getPosts } from "../data/posts";

const config = await getSiteConfig();
const allPosts = await getPosts();
---

<BaseLayout title={`文章 | ${config.title}`}>
  <section class="friends-page">
    <h2 class="friends-title">文章</h2>
    <PostRows posts={allPosts} />
  </section>
</BaseLayout>
