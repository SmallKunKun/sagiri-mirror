---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteConfig } from "../../data/backend";
import { getArticleContent } from "../../data/article";
import { getPosts, type PostSummary } from "../../data/posts";

interface Props {
  post: PostSummary;
}

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const config = await getSiteConfig();
const allPosts = await getPosts();
const article = await getArticleContent(post);

const index = allPosts.findIndex((item) => item.slug === post.slug);
const newer = index > 0 ? allPosts[index - 1] : null;
const older = index >= 0 ? (allPosts[index + 1] ?? null) : null;

const month = post.publishedAt.slice(5, 7);
const day = post.publishedAt.slice(8, 10);
const firstImage = article.html.match(/<img[^>]+src=["']([^"']+)["']/i)?.[1];
const showCover = Boolean(post.cover && firstImage !== post.cover.url);
---

<BaseLayout
  title={`${post.title} | ${config.title}`}
  description={post.summary}
  toc={article.toc}
>
  <article class="post-single">
    <div class="post-date" aria-hidden="true">
      <span class="post-month">{month}月</span>
      <span class="post-day">{day}</span>
    </div>

    {post.category !== "未分类" ? (
      <a
        class="post-badge"
        href={`/categories/${encodeURIComponent(post.category)}/`}
      >
        {post.category}
      </a>
    ) : null}

    <header class="post-single-header">
      <h1 class="post-single-title">{post.title}</h1>

      <div class="post-meta">
        <span class="post-time">
          <svg
            class="post-meta-icon"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
          <span class="post-meta-label">发表于</span>
          <time datetime={post.publishedAt} title="创建于">
            {post.publishedAt.slice(0, 10)}
          </time>
        </span>

        <span class="post-readtime">
          <span class="post-meta-divider" aria-hidden="true">•</span>
          <svg
            class="post-meta-icon"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <span class="post-meta-label">阅读时长</span>
          <span>{post.readingTime} 分钟</span>
        </span>
      </div>
    </header>

    {showCover && post.cover ? (
      <img
        class="post-single-cover"
        src={post.cover.url}
        alt=""
        width={post.cover.width ?? undefined}
        height={post.cover.height ?? undefined}
        loading="eager"
      />
    ) : null}

    <div class="post-body-single" set:html={article.html}></div>

    {post.tags.length > 0 ? (
      <div class="post-single-tags">
        {post.tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
        ))}
      </div>
    ) : null}

    {newer || older ? (
      <nav class="post-nav" aria-label="相邻文章">
        {older ? (
          <a class="post-nav-prev" href={`/post/${older.slug}/`}>
            ← {older.title}
          </a>
        ) : (
          <span></span>
        )}
        {newer ? (
          <a class="post-nav-next" href={`/post/${newer.slug}/`}>
            {newer.title} →
          </a>
        ) : null}
      </nav>
    ) : null}
  </article>
</BaseLayout>
