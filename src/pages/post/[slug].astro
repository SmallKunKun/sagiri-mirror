---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteConfig } from "../../data/backend";
import { getArticleContent } from "../../data/article";
import { getPosts, type PostSummary } from "../../data/posts";
import { withBase } from "../../utils/url";

interface Props {
  post: PostSummary;
}

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const config = await getSiteConfig();
const allPosts = await getPosts();
const content = await getArticleContent(post);

const index = allPosts.findIndex((item) => item.slug === post.slug);
const newer = index > 0 ? allPosts[index - 1] : null;
const older = index >= 0 ? (allPosts[index + 1] ?? null) : null;

const month = post.publishedAt.slice(5, 7);
const day = post.publishedAt.slice(8, 10);
const firstImage = content.html.match(/<img[^>]+src=["']([^"']+)["']/i)?.[1];
const showCover = Boolean(post.cover && firstImage !== post.cover.url);
---

<BaseLayout
  title={`${post.title} | ${config.title}`}
  description={post.summary}
  toc={content.toc}
  article
>
  <article class="post-single">
    <div class="post-date" aria-hidden="true">
      <span class="post-month">{month}月</span>
      <span class="post-day">{day}</span>
    </div>

    {post.category !== "未分类" ? (
      <a
        class="post-badge"
        href={withBase(`/categories/${encodeURIComponent(post.category)}/`)}
      >
        {post.category}
      </a>
    ) : null}

    <header class="post-single-header">
      <h1 class="post-single-title">{post.title}</h1>

      <div class="post-meta">
        <span class="post-time">
          <svg
            class="post-meta-icon"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M3 10h18M8 3v4M16 3v4"></path>
          </svg>
          <span class="post-meta-label">发表于</span>
          <time datetime={post.publishedAt} title="创建于">
            {post.publishedAt.slice(0, 10)}
          </time>
        </span>

        <span class="post-readtime">
          <span class="post-meta-divider" aria-hidden="true">•</span>
          <svg
            class="post-meta-icon"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          <span class="post-meta-label">阅读时长</span>
          <span>{post.readingTime} 分钟</span>
        </span>
      </div>
    </header>

    {showCover && post.cover ? (
      <img
        class="post-single-cover"
        src={post.cover.url}
        alt=""
        width={post.cover.width ?? undefined}
        height={post.cover.height ?? undefined}
        loading="eager"
        draggable="false"
      />
    ) : null}

    <div class="post-body-single" set:html={content.html}></div>

    {post.tags.length > 0 ? (
      <footer class="post-footer">
        <div class="post-tags">
          {post.tags.map((tag, index) => (
            <>
              {index > 0 ? " " : null}
              <a
                href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
                rel="tag"
              >
                # {tag}
              </a>
            </>
          ))}
        </div>
      </footer>
    ) : null}

    {newer || older ? (
      <div class="post-nav">
        <div class="post-nav-next post-nav-item">
          {older ? (
            <a
              href={withBase(`/post/${older.slug}/`)}
              rel="next"
              title={older.title}
            >
              <i class="fas fa-angle-left"></i> {older.title}
            </a>
          ) : null}
        </div>

        <span class="post-nav-divider"></span>

        <div class="post-nav-prev post-nav-item">
          {newer ? (
            <a
              href={withBase(`/post/${newer.slug}/`)}
              rel="prev"
              title={newer.title}
            >
              {newer.title} <i class="fas fa-angle-right"></i>
            </a>
          ) : null}
        </div>
      </div>
    ) : null}
  </article>
</BaseLayout>
